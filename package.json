{
  "name": "squeekchain-hamster-companion",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Independent bilingual 3D virtual hamster companion for Squeekchain",
  "scripts": {
    "start": "node preview.mjs",
    "preview": "node preview.mjs",
    "build": "node tools/build.mjs && node tools/verify-export.mjs",
    "typecheck": "node tools/typecheck.mjs",
    "test": "node tools/run-tests.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "test:chains:browser": "node tools/chain-browser-check.mjs",
    "test:accessibility": "node tools/accessibility-check.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "viem": "2.57.13",
    "playwright": "1.64.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "axe-core": "4.11.1"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
